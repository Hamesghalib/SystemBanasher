<?xml version='1.0' encoding='utf-8'?>
<widget id="com.elite.banasher" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>بنشر النخبة</name>
    <description>نظام محاسبي ونقطة بيع لإدارة البنشر والمخزون والعملاء والديون.</description>
    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="Orientation" value="default" />
    <preference name="Fullscreen" value="false" />
    <preference name="DisallowOverscroll" value="true" />
    <icon src="www/res/icon.png" />
</widget>
